# Application Environment (development, production, test)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/identity
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# JWT & Crypto Configuration (JWT_PRIVATE_KEY_* is strictly REQUIRED in production)
JWT_ISSUER=identity-service
JWT_AUDIENCE=backend-services
# JWT_PRIVATE_KEY_PATH=/secrets/private.pem
# JWT_PRIVATE_KEY_PEM=...
JWT_KEY_ID=key-1
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Authentication Providers
# ENABLE_MOCK_PROVIDER=false (Only effective in development/test; strictly forbidden in production)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# X_CLIENT_ID=xxx
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_JWT_SECRET=xxx
