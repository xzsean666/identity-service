# ==============================================================================
# Environment Configuration Template for identity-service
# ==============================================================================

# Application Environment Mode: 'production', 'development', or 'test'
# In 'production' mode:
# - JWT_PRIVATE_KEY_PEM or JWT_PRIVATE_KEY_PATH is strictly mandatory.
# - Mock provider is hard-disabled.
# - Strict provider validations are enforced.
APP_ENV=production

# Server Network Binding
APP_HOST=0.0.0.0
APP_PORT=8080

# Tracing and Logging (RUST_LOG filter syntax)
RUST_LOG=identity_service=info,tower_http=info

# Database Configuration (External PostgreSQL 14+)
# When connecting to PostgreSQL running on the Docker host:
#   DATABASE_URL=postgres://user:password@host.docker.internal:5432/identity
# When connecting to managed cloud PostgreSQL (e.g. AWS RDS, GCP Cloud SQL):
#   DATABASE_URL=postgres://user:password@db.example.com:5432/identity?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/identity
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# JWT Cryptography & Token Lifetime
JWT_ISSUER=identity-service
JWT_AUDIENCE=backend-services
JWT_KEY_ID=key-1
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Asymmetric Ed25519 Signing Key (MANDATORY in production)
# Generate a key with: openssl genpkey -algorithm ed25519 -out private.pem
# Provide either the file path OR the inline PEM string:
# JWT_PRIVATE_KEY_PATH=/etc/identity/private.pem
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Third-Party Identity Providers (Configure based on enabled integrations)
# Google OAuth2 Client ID for ID Token verification
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# X (Twitter) OAuth2 Client ID
# X_CLIENT_ID=your-x-client-id

# Supabase Auth Integration
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Development / Testing Mock Provider (ONLY effective when APP_ENV != production)
# ENABLE_MOCK_PROVIDER=false
