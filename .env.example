# Application Environment (development, production, test)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/identity

# JWT & Crypto Configuration
JWT_ISSUER=identity-service
JWT_AUDIENCE=backend-services
# JWT_PRIVATE_KEY_PATH=/secrets/private.pem
# JWT_PRIVATE_KEY_PEM=...
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Authentication Providers (Optional, configure when enabled)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# X_CLIENT_ID=xxx
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_JWT_SECRET=xxx
